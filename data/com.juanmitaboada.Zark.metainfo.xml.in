<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.juanmitaboada.Zark</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name translate="no">zark</name>
  <summary>See the state of your zark backups and backup drives</summary>
  <developer id="com.juanmitaboada">
    <name translate="no">Juanmi Taboada</name>
  </developer>
  <description>
    <p>
      zark backs up and recovers Ubuntu systems installed on encrypted ZFS.
      This app shows how its backups stand: how full the system pools are,
      each backup drive with its last backup, its space and its backup
      points by month, the datasets left out of backups, and a backup
      running in a terminal, with its progress.
    </p>
    <p>
      It runs zark's operations: each is one zark command, run with the
      administrator's password through pkexec, in a terminal inside the
      window where zark asks its questions as it always does.
    </p>
  </description>
  <launchable type="desktop-id">com.juanmitaboada.Zark.desktop</launchable>
  <url type="homepage">https://github.com/juanmitaboada/zark-gnome-app</url>
  <url type="bugtracker">https://github.com/juanmitaboada/zark-gnome-app/issues</url>
  <url type="vcs-browser">https://github.com/juanmitaboada/zark-gnome-app</url>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <!-- Release notes are not translated: they age fast. -->
  <releases>
    <release version="1.2.0" date="2026-11-18">
      <description translate="no">
        <p>
          The app in Spanish, Brazilian and European Portuguese, French,
          Italian, Catalan, Galician, German and Dutch, with the
          administrator's password dialogs translated too. Prepare a New
          Drive says what zark does: the disk must be empty, and zark
          refuses one with partitions or a format it recognizes.
        </p>
      </description>
    </release>
    <release version="1.1.3" date="2026-11-16">
      <description translate="no">
        <p>
          When a backup's drive goes away, a dialog says so, with the time
          it went and zark's advice, unless zark's GNOME Shell extension
          shows its own.
        </p>
      </description>
    </release>
    <release version="1.1.2" date="2026-11-16">
      <description translate="no">
        <p>
          Fixes: Suspend asks for the administrator's password while the
          app's command runs, a mount offers Open in Files where it ends,
          Prepare leaves out the disks this system uses, a run whose estimate
          grows shows the data sent instead of a percentage, a run cut short
          shows in red, and every run ends with a closing line in the terminal.
        </p>
      </description>
    </release>
    <release version="1.1.1" date="2026-11-12">
      <description translate="no">
        <p>
          Fixes: the page keeps its place when the window redraws, the
          progress shows a percentage of the data only, backup points show
          local time, and a drive mounted for browsing offers Open and
          Unmount.
        </p>
      </description>
    </release>
    <release version="1.1" date="2026-11-12">
      <description translate="no">
        <p>
          Operations: back up, reclaim space, prepare, check, erase and
          register drives, exclusions and retention, each run by zark in a
          terminal inside the window.
        </p>
      </description>
    </release>
    <release version="1.0" date="2026-11-12">
      <description translate="no">
        <p>
          The first version: the state of zark's backups, read-only, for
          zark 2.3.0 and later.
        </p>
      </description>
    </release>
  </releases>
</component>
