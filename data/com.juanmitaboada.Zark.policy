<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">

<!-- zark-gnome-app: one action per zark command the app runs, matched by pkexec on
     the program and its first argument. Installed as
     /usr/share/polkit-1/actions/com.juanmitaboada.Zark.policy. -->
<policyconfig>
  <vendor>zark</vendor>
  <vendor_url>https://github.com/juanmitaboada/zark-gnome-app</vendor_url>
  <icon_name>com.juanmitaboada.Zark</icon_name>

  <action id="com.juanmitaboada.Zark.backup">
    <description>Back up this computer with zark</description>
    <message>Authentication is needed to back up this computer: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">backup</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.prune">
    <description>Reclaim space with zark</description>
    <message>Authentication is needed to reclaim space with zark: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">prune</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.registry">
    <description>Change zark's registry of backup drives</description>
    <message>Authentication is needed to change zark's registry of backup drives: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">registry</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.exclude">
    <description>Change what zark backs up</description>
    <message>Authentication is needed to change what zark backs up: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">exclude</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.mount">
    <description>Mount a backup drive with zark</description>
    <message>Authentication is needed to mount a backup drive: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">mount</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.umount">
    <description>Unmount a backup drive with zark</description>
    <message>Authentication is needed to unmount a backup drive: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">umount</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.explore">
    <description>Look for backup drives with zark</description>
    <message>Authentication is needed to look for backup drives: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">explore</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.clean">
    <description>Clean up after a stopped zark run</description>
    <message>Authentication is needed to clean up after a stopped zark run: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">clean</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.status">
    <description>Refresh zark's status</description>
    <message>Authentication is needed to refresh zark's status: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">status</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.alerts">
    <description>Turn zark's hourly checks on or off</description>
    <message>Authentication is needed to change zark's hourly checks: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">alerts</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.fullcheck">
    <description>Verify a backup drive with zark</description>
    <message>Authentication is needed to verify a backup drive: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">fullcheck</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.prepare">
    <description>Prepare a new backup drive with zark (erases it)</description>
    <message>Authentication is needed to prepare a backup drive, which erases it: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">prepare</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.purge">
    <description>Erase a backup drive with zark</description>
    <message>Authentication is needed to erase a backup drive: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">purge</annotate>
  </action>

  <action id="com.juanmitaboada.Zark.health">
    <description>Check a drive's health with zark (may erase it)</description>
    <message>Authentication is needed to check a drive's health, which can erase it: $(cmdline_short)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/zark/zark</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">health</annotate>
  </action>

</policyconfig>
