"""Launcher: the app's package sits beside this file once resolved
(/usr/bin/zark-gnome-app links to /usr/share/zark-gnome-app/)."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

# pylint: disable=wrong-import-position
from zark_app.main import main  # noqa: E402

sys.exit(main())
