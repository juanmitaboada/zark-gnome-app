"""Runs the app from this tree on a fixture case, live: the window reads the
case's files as the installed app reads the real ones.

    ZARK_SRC=../zark dev/run app:connected
    ZARK_SRC=../zark dev/run zark:running

Without a case it runs on the real files, with the reader of ZARK_SRC.
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

# pylint: disable=wrong-import-position
from dataclasses import replace  # noqa: E402

from tests.harness import any_case, zark_src  # noqa: E402
from zark_app.gio_runner import GioRunner  # noqa: E402
from zark_app.main import ZarkApp  # noqa: E402
from zark_app.reader import load  # noqa: E402
from zark_app.sources import Sources  # noqa: E402

if len(sys.argv) > 1:
    case = any_case(sys.argv[1])
    app = ZarkApp(case.sources, case.loaded)
else:
    sources = replace(Sources(runner=GioRunner()), zark_dir=zark_src())
    app = ZarkApp(sources, load(sources.zark_dir))
sys.exit(app.run([sys.argv[0]]))
